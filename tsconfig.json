{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@pages/*": ["src/pages/*"],
      "@content/*": ["src/content/*"],
      "@component/*": ["src/component/*"],
      "@context/*": ["src/context/*"],
      "@styles/*": ["src/styles/*"],
      "@theme/*": ["src/theme/*"],
      "@layout/*": ["src/layout/*"]
    }
  },
  "include": ["src", "pages", "content", "component", "context", "styles", "theme", "layout"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
